# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 (configurado dentro do GTM na maioria dos casos, mas
# mantido aqui caso seja necessário instalar diretamente)
NEXT_PUBLIC_GA4_ID=

# Google Ads — ID de conversão (formato AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Webhook de leads do Ads Studio (https://ads-studio.reinoagency.com/api/leads/webhook/<token>)
# Token gerado em clients.leads_webhook_token para o cliente JS AR Central.
ADS_STUDIO_LEADS_WEBHOOK_URL=
